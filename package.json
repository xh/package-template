{
  "name": "@xh/package-template",
  "version": "4.0.0",
  "description": "A stub package to demo code sharing across Hoist client apps.",
  "repository": "github:xh/package-template",
  "homepage": "https://xh.io",
  "bugs": "https://github.com/xh/package-template/issues",
  "author": "Extremely Heavy Industries, Inc.",
  "license": "Apache-2.0",
  "files": [
    "desktop"
  ],
  "scripts": {
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint:code && pnpm lint:styles && pnpm lint:format && pnpm lint:types",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "lint:format": "prettier --check \"**/*.{js,jsx,ts,tsx,scss,sass,css}\"",
    "lint:types": "tsc",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "peerDependencies": {
    "@xh/hoist": ">=88.1.2 || >=89.0.0-SNAPSHOT",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xh/eslint-config": "^8.1.0",
    "@xh/hoist": "^88.1.2",
    "ag-grid-community": "~36.2.0",
    "ag-grid-react": "~36.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6"
}
